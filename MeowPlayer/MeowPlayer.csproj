<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ThisAssemblyNamespace>GitInfo</ThisAssemblyNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\External\AeroAvalonia\src\AeroAvalonia\AeroAvalonia.csproj" />
        <ProjectReference Include="..\External\ManagedBass\src\Bass\Portable\Bass.csproj" />
        <PackageReference Include="GitInfo">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BuildDate</_Parameter1>
            <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss zzz"))</_Parameter2>
        </AssemblyAttribute>
        
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BuildHostOS</_Parameter1>
            <_Parameter2>$([System.Runtime.InteropServices.RuntimeInformation]::OSDescription)</_Parameter2>
        </AssemblyAttribute>
        
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>BuildHostArch</_Parameter1>
            <_Parameter2>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>
</Project>
